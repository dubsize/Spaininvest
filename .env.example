# Copy to .env and adjust:  cp .env.example .env
# NEVER commit .env. All secrets are read from environment variables.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- database (used by docker compose) ---------------------------------
POSTGRES_USER=arbscan
POSTGRES_PASSWORD=arbscan
POSTGRES_DB=arbscan

# --- dashboard login (single user) ---------------------------------------
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash.  Generate:  docker compose run --rm api python -m arbscan.cli hash-password
# In this file every "$" of the hash must be doubled ("$$") for docker compose.
ADMIN_PASSWORD_HASH=
# Development convenience only (plaintext). Leave empty when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=change-me
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_HOURS=168
# Set true when served over HTTPS
COOKIE_SECURE=false
PUBLIC_WEB_URL=http://localhost:3000

# --- business defaults -----------------------------------------------------
DEFAULT_RESALE_COUNTRY=ES
DEFAULT_TARGET_ROI=0.25
DEFAULT_MIN_ROI=0.15

# --- demo data ---------------------------------------------------------------
# Seed ~600 synthetic listings on first start (purge later in Settings).
SEED_DEMO_DATA=true

# --- scanning --------------------------------------------------------------
SCANNER_ENABLED=true
SCANNER_TICK_SECONDS=60
RESPECT_ROBOTS_TXT=true
# Identify yourself to sites you fetch from (used in the User-Agent).
HTTP_CONTACT=
# Only set a proxy if you are entitled to use it. Never use proxies to evade blocks.
OUTBOUND_PROXY_URL=

# --- eBay (official Browse API) -------------------------------------------
# Create a keyset at https://developer.ebay.com/my/keys (Production) and paste it here.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_AFFILIATE_CAMPAIGN_ID=

# --- alerts ------------------------------------------------------------------
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=

# --- optional AI normalisation (never required) ----------------------------
AI_NORMALIZER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- FX ----------------------------------------------------------------------
# Refresh rates daily from the ECB reference-rate feed
FX_AUTO_UPDATE=false
